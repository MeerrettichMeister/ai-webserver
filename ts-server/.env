DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?connection_limit=10"

KEYCLOAK_URL="localhost"
KEYCLOAK_PORT="8080"
KEYCLOAK_REALM="ai-webserver"
# Keycloak client the API's clients get their tokens from; it must be in the token's `aud`.
KEYCLOAK_CLIENT_ID="ts-server"

PORT="3000"